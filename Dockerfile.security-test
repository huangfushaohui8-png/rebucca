# 仅安全验证镜像，不能作为生产产品镜像；构建联网、运行期network=none。
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY tests/requirements-security.txt /tmp/requirements-security.txt
RUN pip install --no-cache-dir -r /tmp/requirements-security.txt
WORKDIR /code
# 有意排除样例数据库、附带ZLM/模型二进制以及其他业务静态文件。
COPY app /code/app
COPY framework /code/framework
COPY tests /code/tests
COPY settings.json language-*.json /code/
COPY zlm/bin.x86.gcc9.4/config.ini /code/zlm/bin.x86.gcc9.4/config.ini
ENV PYTHONDONTWRITEBYTECODE=1 REBUCCA_TEST_RTSP=1
USER 65534:65534
CMD ["python", "-m", "tests.run_security"]
